# Self-Healing Playwright Agent — environment template
# Copy to .env and fill in real values. NEVER commit .env (see .gitignore).

# ── LLM providers (ADR-003: split agent vs judge) ────────────────────────────
# Agent (triage + heal) = OpenAI. Judge = DeepSeek (independent vendor → less bias).

# OpenAI — triage + heal
OPENAI_API_KEY=

# DeepSeek — judge (OpenAI-API-compatible; client uses DEEPSEEK_BASE_URL)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Anthropic — not used (kept for reference if you ever switch the agent provider)
# ANTHROPIC_API_KEY=

# ── Langfuse (runtime observability: traces, scores, cost, latency) ───────────
# Get these from Langfuse → Settings → API Keys.
LANGFUSE_PUBLIC_KEY=        # pk-lf-...
LANGFUSE_SECRET_KEY=        # sk-lf-...
LANGFUSE_HOST=https://us.cloud.langfuse.com   # US region; EU = https://cloud.langfuse.com
